<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070A0F">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:text="JARVIS" android:textColor="#55E7FF" android:textSize="34sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Android Companion" android:textColor="#9AA7B8" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="24dp"/>
<TextView android:text="PC address" android:textColor="#F4F8FF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/urlInput" android:hint="http://192.168.1.10:47821" android:textColor="#F4F8FF" android:hintTextColor="#6E7A8C" android:singleLine="true" android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="5-letter pairing code" android:textColor="#F4F8FF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
<EditText android:id="@+id/tokenInput" android:hint="ABCDE" android:textColor="#F4F8FF" android:hintTextColor="#6E7A8C" android:singleLine="true" android:maxLength="5" android:inputType="textCapCharacters" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/connectButton" android:text="Connect to JARVIS" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"/>
<TextView android:id="@+id/status" android:text="Not connected" android:textColor="#9AA7B8" android:textSize="15sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
<EditText android:id="@+id/commandInput" android:hint="Ask JARVIS or type a command" android:textColor="#F4F8FF" android:hintTextColor="#6E7A8C" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"/>
<Button android:id="@+id/sendButton" android:text="Send Command" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/scanButton" android:text="Scan Network Devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<Button android:id="@+id/accessibilityButton" android:text="Open Accessibility Settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/output" android:textColor="#F4F8FF" android:textSize="15sp" android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
